# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---------------------------------------------------------------------
# Public base URL, used for OAuth and email-confirmation redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Dashboard → Project Settings → API Keys) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) / legacy service_role key. Server-only; bypasses RLS.
# Used to cache Mapbox Search results into the `destinations` and `places` tables.
SUPABASE_SECRET_KEY=

# --- Google OAuth (only needed when running Supabase locally with the CLI) ----
# For a hosted project, set these in Dashboard → Authentication → Sign In / Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Maps & place search -----------------------------------------------------
# Mapbox public token (pk.*) for itinerary maps and Search Box place/destination search.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional secret token (sk.*) for server-side Search Box. Falls back to the public token.
MAPBOX_TOKEN=

# --- Photos ------------------------------------------------------------------
# Unsplash fallback for destination header photos. Server-only.
UNSPLASH_ACCESS_KEY=
